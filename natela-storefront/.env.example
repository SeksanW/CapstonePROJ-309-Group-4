# Copy to .env.local (git-ignored). On the hosting site, set these as
# environment variables instead.

# The API gateway. Local backend: http://localhost:8080
VITE_API_URL=http://localhost:8080

# Google Analytics 4 measurement ID (Admin → Data streams → your web
# stream), e.g. G-XXXXXXXXXX. Leave empty to keep Google Analytics off.
# It only loads after a shopper accepts the cookie banner.
VITE_GA_MEASUREMENT_ID=
